{
  "id": "ui/touch",
  "scale": 4,
  "origin": [0.5, 1],
  "fallback": "dpad_down",
  "frames": [
    {"h": 40, "image": "assets/images/ui/touch/dpad-Sheet.png", "w": 40, "x": 0, "y": 0},
    {"h": 40, "image": "assets/images/ui/touch/dpad-Sheet.png", "w": 40, "x": 40, "y": 0},
    {"h": 40, "image": "assets/images/ui/touch/dpad-Sheet.png", "w": 40, "x": 80, "y": 0},
    {"h": 40, "image": "assets/images/ui/touch/dpad-Sheet.png", "w": 40, "x": 120, "y": 0},
    {"h": 40, "image": "assets/images/ui/touch/dpad-Sheet.png", "w": 40, "x": 160, "y": 0},
    {"h": 40, "image": "assets/images/ui/touch/dpad-Sheet.png", "w": 40, "x": 200, "y": 0},
    {"h": 40, "image": "assets/images/ui/touch/dpad-Sheet.png", "w": 40, "x": 240, "y": 0},
    {"h": 32, "image": "assets/images/ui/touch/jump-Sheet.png", "w": 32, "x": 0, "y": 0},
    {"h": 32, "image": "assets/images/ui/touch/jump-Sheet.png", "w": 32, "x": 32, "y": 0},
    {"h": 24, "image": "assets/images/ui/touch/light-Sheet.png", "w": 24, "x": 0, "y": 0},
    {"h": 24, "image": "assets/images/ui/touch/light-Sheet.png", "w": 24, "x": 24, "y": 0}
  ],
  "anims": {
    "dpad_down": {"at": [4], "fps": 8, "frameW": 40, "frames": [4], "loop": true, "sheet": "dpad-Sheet.png"},
    "dpad_down_left": {"at": [5], "fps": 8, "frameW": 40, "frames": [5], "loop": true, "sheet": "dpad-Sheet.png"},
    "dpad_down_right": {"at": [6], "fps": 8, "frameW": 40, "frames": [6], "loop": true, "sheet": "dpad-Sheet.png"},
    "dpad_left": {"at": [2], "fps": 8, "frameW": 40, "frames": [2], "loop": true, "sheet": "dpad-Sheet.png"},
    "dpad_neutral": {"at": [1], "fps": 8, "frameW": 40, "frames": [1], "loop": true, "sheet": "dpad-Sheet.png"},
    "dpad_right": {"at": [3], "fps": 8, "frameW": 40, "frames": [3], "loop": true, "sheet": "dpad-Sheet.png"},
    "dpad_up": {"at": [7], "fps": 8, "frameW": 40, "frames": [7], "loop": true, "sheet": "dpad-Sheet.png"},
    "jump_pressed": {"at": [2], "fps": 8, "frameW": 32, "frames": [9], "loop": true, "sheet": "jump-Sheet.png"},
    "jump_up": {"at": [1], "fps": 8, "frameW": 32, "frames": [8], "loop": true, "sheet": "jump-Sheet.png"},
    "light_pressed": {"at": [2], "fps": 8, "frameW": 24, "frames": [11], "loop": true, "sheet": "light-Sheet.png"},
    "light_up": {"at": [1], "fps": 8, "frameW": 24, "frames": [10], "loop": true, "sheet": "light-Sheet.png"}
  }
}
