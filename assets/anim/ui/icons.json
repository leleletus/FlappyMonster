  "anims": {
    "check": {"fps": 4, "frames": [1], "loop": true},
    "crown": {"fps": 4, "frames": [2], "loop": true},
    "flag": {"fps": 4, "frames": [3], "loop": true},
    "hill": {"fps": 4, "frames": [4], "loop": true},
    "lock": {"fps": 4, "frames": [5], "loop": true},
    "skull": {"fps": 4, "frames": [6], "loop": true}
